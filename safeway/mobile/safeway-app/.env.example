# =========================
# 📍 Kakao API
# =========================

# 카카오 JavaScript 키 (지도 WebView에서 사용)
EXPO_PUBLIC_KAKAO_JS_KEY=your_kakao_javascript_key_here

# 카카오 REST API 키 (로그인 등)
KAKAO_REST_API_KEY=your_kakao_rest_api_key_here


# =========================
# 🌐 Backend
# =========================

# 백엔드 서버 주소
EXPO_PUBLIC_API_BASE_URL=


# =========================
# 📱 App Config
# =========================

# 딥링크 스킴 (카카오 로그인 redirect 등)
EXPO_PUBLIC_APP_SCHEME=


# =========================
# 🔥 기타 (필요시 추가)
# =========================

# 예: Sentry, Firebase 등
# EXPO_PUBLIC_SENTRY_DSN=
# EXPO_PUBLIC_FIREBASE_API_KEY=