# Local Docker defaults.
# Copy this file to .env inside infra/ when you want to override values locally.

POSTGRES_DB=safeway
POSTGRES_USER=safeway
POSTGRES_PASSWORD=your_postgres_password_here
SPRING_DATASOURCE_USERNAME=safeway
SPRING_DATASOURCE_PASSWORD=your_postgres_password_here
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379
SERVER_PORT=8080

# Kakao app keys.
KAKAO_JAVASCRIPT_KEY=your_kakao_javascript_key_here
KAKAO_REST_API_KEY=your_kakao_rest_api_key_here

# Local Docker exposes the backend as localhost:18080 on your browser.
# If you run Spring directly with Gradle, use http://localhost:8080/callback instead.
KAKAO_REDIRECT_URI=http://localhost:18080/callback

# Add your frontend origin here if it is different.
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:18080
